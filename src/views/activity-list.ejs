<%- include('partials/header') %>

<h1>Activities &amp; Events</h1>

<form method="GET" action="/activities" class="filter-bar">
  <input type="text" name="search" placeholder="Search by title or organizer..." value="<%= search %>">
  <select name="type">
    <option value="">All Types</option>
    <% types.forEach(function(t) { %>
      <option value="<%= t.id %>" <%= String(type) === String(t.id) ? 'selected' : '' %>><%= t.name %></option>
    <% }) %>
  </select>
  <button type="submit" class="btn btn-primary">Filter</button>
</form>

<table>
  <thead>
    <tr><th>Title</th><th>Type</th><th>Organizer</th><th>Date</th><th>Mode</th><th>Participants</th><th></th></tr>
  </thead>
  <tbody>
    <% activities.forEach(function(a) { %>
      <tr>
        <td><%= a.title %></td>
        <td><%= a.type_name %></td>
        <td><%= a.organizer %></td>
        <td><%= a.event_date %></td>
        <td><%= a.mode %></td>
        <td><%= a.participant_count %></td>
        <td><a href="/activities/<%= a.id %>" class="btn btn-small">View</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/footer') %>
