<%- include('partials/header') %>

<h1>Activities & Events</h1>

<a href="/activities/new" class="btn btn-primary" style="margin-bottom: 1rem;">+ Add New Activity</a>

<table>
  <thead>
    <tr><th>Title</th><th>Type</th><th>Organizer</th><th>Date</th><th>Mode</th><th>Participants</th><th></th></tr>
  </thead>
  <tbody>
    <% activities.forEach(function(a) { %>
      <tr>
        <td><%= a.title %></td>
        <td><%= a.type_name %></td>
        <td><%= a.organizer %></td>
        <td><%= a.event_date %></td>
        <td><%= a.mode %></td>
        <td><%= a.participant_count %></td>
        <td><a href="/activities/<%= a.id %>" class="btn btn-small">View</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('partials/footer') %>
